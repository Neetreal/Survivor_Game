func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	locale = Records.settings_language

func has_translation(text: String) -> bool:
	return EN.has(text)

## Перевод строки (или шаблона формата — переводим ДО подстановки значений).
func t(text: String) -> String:
	if locale == "ru":
		return text
	return str(EN.get(text, text))

func language_name(id: String) -> String:
	return "Русский" if id == "ru" else "English"

func set_locale(new_locale: String) -> void:
	if not LANGUAGES.has(new_locale) or new_locale == locale:
		return
	locale = new_locale
	Records.set_language(new_locale)
	locale_changed.emit()

## Переводит все подписи внутри сцены. Оригинал запоминается в метаданных,
## поэтому повторный вызов (например, при смене языка) ничего не испортит.
func translate_tree(root: Node) -> void:
	if root is Control:
		translate_control(root)
	for node in root.find_children("*", "Control", true, false):
		translate_control(node)

func translate_control(node: Node) -> void:
	var control = node
	if not (control is Label or control is Button or control is RichTextLabel):
		return
	if not control.has_meta("loc_source"):
		control.set_meta("loc_source", str(control.text))
	control.text = t(str(control.get_meta("loc_source")))
